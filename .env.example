# BuilderDNA environment variables
# Copy this file to .env and fill in your values

# REQUIRED: GitHub Personal Access Token (classic token with public_repo scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Optional: Ollama embedding server (needed for pain command)
# Default: http://localhost:11434/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1

# Optional: embedding model name (must be available in your Ollama instance)
# Default: bge-m3:latest
EMBEDDING_MODEL=bge-m3:latest

# OpenCLI browser commands run in a background window by default (no foreground popup).
# Override per-command with `opencli browser <session> ... --window foreground` if needed.
OPENCLI_WINDOW=background
